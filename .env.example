# HackathonFinder environment. Copy to `.env` at the repo root; the website, the
# discovery agents and the scripts all read this one file. Everything is optional
# for local development: `pnpm dev` starts a local MongoDB when MONGODB_URI is empty.

# ── Database ───────────────────────────────────────────────────────────────
# MongoDB Atlas: Database → Connect → Drivers. Leave empty locally to use the
# built-in local database (data kept in .data/mongo).
MONGODB_URI=
MONGODB_DB=hackathonfinder

# ── Site and sign-in ───────────────────────────────────────────────────────
# Public URL of the site (used in emails and sign-in redirects).
# Production: https://hackathonfinder.in
NEXTAUTH_URL=http://localhost:3000
# Required in production. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Comma-separated emails that get the admin role (review queue, sources, agents), once the
# account's email is verified (confirmation link, or Google/GitHub sign-in).
ADMIN_EMAILS=

# "Continue with Google": console.cloud.google.com → APIs & Services → Credentials →
# OAuth client (Web). Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Continue with GitHub": github.com/settings/developers → OAuth App.
# Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# ── Email (verification, password reset, reminders, digest) ────────────────
# resend.com API key. Without it, emails are printed in the server log.
RESEND_API_KEY=
EMAIL_FROM="HackathonFinder <hello@hackathonfinder.in>"

# ── AI (Extractor, Writer, smart search) ───────────────────────────────────
# console.anthropic.com → API keys. Without it, connectors with structured data
# still work and rule-based tagging is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── Images (posters, banners, uploads) ─────────────────────────────────────
# cloudinary.com → Dashboard. Without it, uploads are saved to apps/web/public/uploads
# in development only, and scraped images are linked from their source.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Discovery sources (apps/agents) ────────────────────────────────────────
# Unstop, Devfolio, Devpost, MLH, HackerEarth, lablab.ai and KnowAFest need no keys.
# Web search (hackathons on college and event pages, and Instagram/LinkedIn/Facebook
# posts) uses the first of these that is set; without any, DuckDuckGo, which often
# blocks crawlers. Google Programmable Search: programmablesearchengine.google.com
# (engine id = CX) and an API key for the Custom Search JSON API.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Brave Search API (api-dashboard.search.brave.com), an alternative to Google.
BRAVE_SEARCH_API_KEY=
# Optional SearXNG instance URL with the JSON API enabled, e.g. https://search.example.com.
# Only use an instance that permits automated queries; it can search several engines from one endpoint.
SEARXNG_URL=
# Instagram Graph API (official): a Facebook app with an Instagram Business or
# Creator account. Adds public hashtag posts (caption and poster) to the review queue.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Kaggle API (competitions): kaggle.com → Settings → Create new token. (Not used yet.)
KAGGLE_USERNAME=
KAGGLE_KEY=
# Eventbrite API private token. (Not used yet: Eventbrite has no public event search.)
EVENTBRITE_TOKEN=
# Identifies our crawler to websites. Keep the contact URL real.
CRAWLER_USER_AGENT="HackathonFinderBot/1.0 (+https://hackathonfinder.in/bot)"
# Scheduled scrapes (02:00 and 14:00 IST) run inside the website on a long-running
# server. "off" turns that off (use Vercel Cron or `pnpm agents:schedule` instead).
SCRAPE_SCHEDULER=
# On startup, run once for a slot missed while the server was off. Default: on in
# production (`next start`), off in development. "on" or "off" to choose.
SCRAPE_CATCHUP=

# ── Search engines ─────────────────────────────────────────────────────────
# Verification codes from Google Search Console and Bing Webmaster Tools (HTML tag method,
# just the content="…" value). Then submit https://hackathonfinder.in/sitemap.xml in both.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── Jobs ───────────────────────────────────────────────────────────────────
# Shared secret for scheduled jobs that call the site (reminders, digest, the
# discovery scrape at /api/cron/scrape). Sent as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ── Local development ──────────────────────────────────────────────────────
LOCAL_MONGO_PORT=27017
