# HackathonFinder environment. Copy to `.env` at the repo root; the website, the
# discovery agents and the scripts all read this one file. Everything is optional
# for local development: `pnpm dev` starts a local MongoDB when MONGODB_URI is empty.

# ── Database ───────────────────────────────────────────────────────────────
# MongoDB Atlas: Database → Connect → Drivers. Leave empty locally to use the
# built-in local database (data kept in .data/mongo).
MONGODB_URI=
MONGODB_DB=hackathonfinder

# ── Site and sign-in ───────────────────────────────────────────────────────
# Public URL of the site (used in emails and sign-in redirects).
NEXTAUTH_URL=http://localhost:3000
# Required in production. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Comma-separated emails that get the admin role (review queue, sources, agents).
ADMIN_EMAILS=

# "Continue with Google": console.cloud.google.com → APIs & Services → Credentials →
# OAuth client (Web). Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Continue with GitHub": github.com/settings/developers → OAuth App.
# Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# ── Email (verification, password reset, reminders, digest) ────────────────
# resend.com API key. Without it, emails are printed in the server log.
RESEND_API_KEY=
EMAIL_FROM="HackathonFinder <hello@hackathonfinder.in>"

# ── AI (Extractor, Writer, smart search) ───────────────────────────────────
# console.anthropic.com → API keys. Without it, connectors with structured data
# still work and rule-based tagging is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── Images (posters, banners, uploads) ─────────────────────────────────────
# cloudinary.com → Dashboard. Without it, uploads are saved to apps/web/public/uploads
# in development only, and scraped images are linked from their source.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Discovery sources (apps/agents) ────────────────────────────────────────
# Google Programmable Search: programmablesearchengine.google.com (engine id = CX)
# and an API key from console.cloud.google.com (Custom Search JSON API).
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Instagram Graph API (official): a Facebook app with an Instagram Business or
# Creator account. Used for hashtag search and Business Discovery of club accounts.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Kaggle API (competitions): kaggle.com → Settings → Create new token.
KAGGLE_USERNAME=
KAGGLE_KEY=
# Eventbrite API private token (events near our cities).
EVENTBRITE_TOKEN=
# Identifies our crawler to websites. Keep the contact URL real.
CRAWLER_USER_AGENT="HackathonFinderBot/1.0 (+https://hackathonfinder.in/bot)"

# ── Jobs ───────────────────────────────────────────────────────────────────
# Shared secret for scheduled jobs that call the site (reminders, digest, agents).
CRON_SECRET=

# ── Local development ──────────────────────────────────────────────────────
LOCAL_MONGO_PORT=27017
