{
  "name": "hackathonfinder",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "pnpm --filter @hackathonfinder/web dev",
