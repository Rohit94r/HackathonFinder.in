{
  "name": "hackathonfinder",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @hackathonfinder/web dev",
    "build": "pnpm --filter @hackathonfinder/web build",
    "start": "pnpm --filter @hackathonfinder/web start",
    "lint": "pnpm --filter @hackathonfinder/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "db:seed": "pnpm --filter @hackathonfinder/db seed",
    "db:local": "pnpm --filter @hackathonfinder/db mongo",
    "agents:run": "pnpm --filter @hackathonfinder/agents run",
    "agents:schedule": "pnpm --filter @hackathonfinder/agents schedule",
    "agents:sources": "pnpm --filter @hackathonfinder/agents sources"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["mongodb-memory-server", "esbuild"]
  }
}
